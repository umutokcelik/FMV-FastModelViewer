{
  "name": "fmv-local-viewer",
  "productName": "FMV",
  "version": "1.3.4",
  "private": true,
  "description": "Local glTF and GLB model viewer",
  "main": "desktop/main.mjs",
  "type": "module",
  "bin": {
    "fmv": "bin/fmv.mjs"
  },
  "files": [
    "bin/",
    "lib/*.mjs",
    "out/"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node bin/fmv.mjs --no-open",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  }
}
